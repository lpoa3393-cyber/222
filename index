          <pre id="codeGsBlock" class="code-box">/**
 * T1 · HMI Data Logger Inteligente - Backend Google Apps Script (Code.gs)
 * Intermediario entre la HMI estática, Google Sheets («Registros») y OpenAI.
 */

const SHEET_NAME = 'Registros';
const HEADERS = [
  'Timestamp',
  'ID',
  'Zona',
  'Variable',
  'Valor',
  'Unidad',
  'Observación',
  'Origen'
];

/**
 * Inicializa la hoja «Registros» con encabezados y formato base.
 * Ejecutar manualmente una vez para autorizar permisos de Sheets y UrlFetchApp.
 */
function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
  }
  const firstRow = sheet.getRange(1, 1, 1, HEADERS.length).getValues()[0];
  if (firstRow.join('') === '') {
    sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
    sheet.getRange(1, 1, 1, HEADERS.length)
      .setFontWeight('bold')
      .setBackground('#1e293b')
      .setFontColor('#f8fafc');
    sheet.setFrozenRows(1);
  }
  return sheet;
}

/**
 * Endpoint GET: permite consultar el historial almacenado en «Registros».
 */
function doGet(e) {
  try {
    const action = (e && e.parameter && e.parameter.action) || 'history';
    if (action === 'history') {
      const records = getStoredRecords_(50);
      return jsonResponse_({
        status: 'ok',
        records: records,
        total: records.length
      });
    }
    return jsonResponse_({ status: 'error', message: 'Acción GET no soportada.' });
  } catch (err) {
    return jsonResponse_({ status: 'error', message: err.message });
  }
}

/**
 * Endpoint POST: recibe mediciones (con idempotencia) o solicita análisis con OpenAI.
 * Nota: Se usa text/plain en fetch desde navegador para evitar preflight CORS complejo.
 */
function doPost(e) {
  const lock = LockService.getScriptLock();
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return jsonResponse_({ status: 'error', message: 'Cuerpo POST vacío.' });
    }

    const payload = JSON.parse(e.postData.contents);
    const action = payload.action || 'insert';

    if (action === 'insert') {
      lock.waitLock(15000);
      const result = insertMeasurementIdempotent_(payload.record);
      lock.releaseLock();
      return jsonResponse_(result);
    }

    if (action === 'analyze') {
      const analysis = analyzeStoredRecordsWithOpenAI_(payload.apiKey);
      return jsonResponse_(analysis);
    }

    return jsonResponse_({ status: 'error', message: 'Acción POST no reconocida.' });
  } catch (err) {
    if (lock.hasLock()) lock.releaseLock();
    return jsonResponse_({ status: 'error', message: err.message });
  }
}

/**
 * Inserta una medición verificando que su ID único no exista previamente (idempotencia).
 */
function insertMeasurementIdempotent_(rec) {
  if (!rec || !rec.id || rec.valor === undefined || rec.valor === null) {
    throw new Error('Registro incompleto: se requiere ID y Valor.');
  }

  const sheet = setup();
  const lastRow = sheet.getLastRow();

  // Verificar si el ID ya existe en columna B (índice 2)
  if (lastRow >= 2) {
    const existingIds = sheet.getRange(2, 2, lastRow - 1, 1).getValues().flat();
    if (existingIds.indexOf(String(rec.id)) !== -1) {
      return {
        status: 'ok',
        confirmed: true,
        duplicate: true,
        id: rec.id,
        message: 'Registro ya confirmado previamente (idempotencia).'
      };
    }
  }

  const row = [
    rec.timestamp || new Date().toISOString(),
    String(rec.id),
    rec.zona || 'Zona-T1',
    rec.variable || 'Temperatura',
    Number(rec.valor),
    rec.unidad || '°C',
    rec.observacion || 'Muestreo automático HMI',
    rec.origen || 'HMI-Web-GitHubPages'
  ];

  sheet.appendRow(row);
  SpreadsheetApp.flush();

  return {
    status: 'ok',
    confirmed: true,
    duplicate: false,
    id: rec.id
  };
}

/**
 * Lee los últimos N registros realmente persistidos en Google Sheets.
 */
function getStoredRecords_(limit) {
  const sheet = setup();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];

  const totalDataRows = lastRow - 1;
  const count = Math.min(totalDataRows, limit || 50);
  const startRow = lastRow - count + 1;
  const values = sheet.getRange(startRow, 1, count, HEADERS.length).getValues();

  return values.map(function (r) {
    return {
      timestamp: r[0] instanceof Date ? r[0].toISOString() : String(r[0]),
      id: String(r[1]),
      zona: String(r[2]),
      variable: String(r[3]),
      valor: Number(r[4]),
      unidad: String(r[5]),
      observacion: String(r[6]),
      origen: String(r[7])
    };
  });
}

/**
 * Solicita a OpenAI analizar exclusivamente los registros almacenados en Sheets.
 */
function analyzeStoredRecordsWithOpenAI_(clientApiKey) {
  // En producción, priorizar PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY')
  const serverKey = PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY');
  const apiKey = (serverKey && serverKey.trim()) ? serverKey.trim() : (clientApiKey || '').trim();

  if (!apiKey) {
    throw new Error('No se proporcionó API Key de OpenAI.');
  }

  const records = getStoredRecords_(60);
  if (records.length === 0) {
    throw new Error('La hoja «Registros» no contiene datos persistidos para analizar.');
  }

  const systemPrompt = [
    'Eres un ingeniero especialista en instrumentación y análisis de telemetría industrial.',
    'Analiza ÚNICAMENTE los registros reales entregados desde Google Sheets.',
    'Reglas estrictas:',
    '1. No inventes mediciones, fechas ni IDs que no estén en los datos.',
    '2. Describe tendencias observadas (mínimo, máximo, promedio, estabilidad o derivas) y posibles anomalías.',
    '3. Separa explícitamente el análisis en dos secciones claras: "HECHOS OBSERVADOS" y "RECOMENDACIONES OPERATIVAS".'
  ].join('\n');

  const userPrompt = 'Registros reales almacenados en Google Sheets (total ' + records.length + '):\n' +
    JSON.stringify(records);

  const response = UrlFetchApp.fetch('https://api.openai.com/v1/chat/completions', {
    method: 'post',
    contentType: 'application/json',
    headers: {
      Authorization: 'Bearer ' + apiKey
    },
    payload: JSON.stringify({
      model: 'gpt-4o-mini',
      temperature: 0.2,
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: userPrompt }
      ]
    }),
    muteHttpExceptions: true
  });

  const code = response.getResponseCode();
  const body = JSON.parse(response.getContentText());

  if (code < 200 || code >= 300) {
    const errMsg = (body && body.error && body.error.message) ? body.error.message : ('HTTP ' + code);
    throw new Error('Error OpenAI: ' + errMsg);
  }

  const text = body.choices && body.choices[0] && body.choices[0].message
    ? body.choices[0].message.content
    : 'Sin respuesta textual del modelo.';

  return {
    status: 'ok',
    analyzedCount: records.length,
    analysis: text
  };
}

function jsonResponse_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}</pre>
