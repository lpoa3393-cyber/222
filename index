  <script>
    (() => {
      'use strict';

      /* =========================================================
         ESTADO EN MEMORIA (SIN PERSISTENCIA DE CLAVES)
         ========================================================= */
      const state = {
        running: false,
        intervalSec: 20,
        countdown: 20,
        genTimerId: null,
        tickTimerId: null,
        samples: [],          // { id, timestamp, zona, variable, valor, unidad, observacion, origen, status: 'pending'|'confirmed'|'error', errorMsg? }
        writeQueue: [],       // cola FIFO de objetos sample pendientes
        workerBusy: false,
        sheetsHistory: []
      };

      /* =========================================================
         REFERENCIAS DOM
         ========================================================= */
      const els = {
        tabs: document.querySelectorAll('.tab-btn'),
        panels: document.querySelectorAll('.tab-panel'),
        apiKeyInput: document.getElementById('apiKeyInput'),
        scriptUrlInput: document.getElementById('scriptUrlInput'),
        apiKeyMsg: document.getElementById('apiKeyMsg'),
        urlMsg: document.getElementById('urlMsg'),
        configStatusText: document.getElementById('configStatusText'),
        intervalSlider: document.getElementById('intervalSlider'),
        intervalLabel: document.getElementById('intervalLabel'),
        btnStart: document.getElementById('btnStart'),
        btnPause: document.getElementById('btnPause'),
        btnSync: document.getElementById('btnSync'),
        btnAnalyze: document.getElementById('btnAnalyze'),
        badgeOp: document.getElementById('badgeOp'),
        badgeConn: document.getElementById('badgeConn'),
        badgeErr: document.getElementById('badgeErr'),
        kpiCurrent: document.getElementById('kpiCurrent'),
        kpiLastId: document.getElementById('kpiLastId'),
        kpiAvg: document.getElementById('kpiAvg'),
        kpiCountdown: document.getElementById('kpiCountdown'),
        kpiGen: document.getElementById('kpiGen'),
        kpiConf: document.getElementById('kpiConf'),
        kpiPend: document.getElementById('kpiPend'),
        kpiErr: document.getElementById('kpiErr'),
        workerBadge: document.getElementById('workerBadge'),
        queueList: document.getElementById('queueList'),
        sheetsTableBody: document.getElementById('sheetsTableBody'),
        sheetsCountBadge: document.getElementById('sheetsCountBadge'),
        aiStatus: document.getElementById('aiStatus'),
        aiOutput: document.getElementById('aiOutput'),
        trendCanvas: document.getElementById('trendCanvas'),
        btnCopyCode: document.getElementById('btnCopyCode'),
        codeGsBlock: document.getElementById('codeGsBlock')
      };

      /* =========================================================
         NAVEGACIÓN POR PESTAÑAS
         ========================================================= */
      els.tabs.forEach(btn => {
        btn.addEventListener('click', () => {
          els.tabs.forEach(b => b.classList.remove('active'));
          els.panels.forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          document.getElementById(btn.dataset.tab).classList.add('active');
          if (btn.dataset.tab === 'tab-demo') drawChart();
        });
      });

      /* =========================================================
         VALIDACIÓN DE CONFIGURACIÓN OBLIGATORIA
         ========================================================= */
      function isValidAppsScriptUrl(raw) {
        try {
          const u = new URL(raw.trim());
          return u.protocol === 'https:' &&
                 u.hostname === 'script.google.com' &&
                 u.pathname.endsWith('/exec');
        } catch {
          return false;
        }
      }

      function isValidApiKey(raw) {
        const v = raw.trim();
        return v.startsWith('sk-') && v.length >= 20;
      }

      function validateConfig() {
        const keyOk = isValidApiKey(els.apiKeyInput.value);
        const urlOk = isValidAppsScriptUrl(els.scriptUrlInput.value);

        els.apiKeyMsg.textContent = keyOk
          ? '✓ Formato de API Key válido en memoria.'
          : '✗ Ingrese una API Key de OpenAI válida (sk-...).';
        els.apiKeyMsg.style.color = keyOk ? 'var(--ok)' : 'var(--warn)';

        els.urlMsg.textContent = urlOk
          ? '✓ Endpoint /exec HTTPS validado.'
          : '✗ Debe ser https://script.google.com/.../exec';
        els.urlMsg.style.color = urlOk ? 'var(--ok)' : 'var(--warn)';

        const allOk = keyOk && urlOk;

        els.configStatusText.textContent = allOk ? 'HABILITADO' : 'BLOQUEADO';
        els.configStatusText.style.color = allOk ? 'var(--ok)' : 'var(--warn)';

        els.btnStart.disabled = !allOk || state.running;
        els.btnPause.disabled = !state.running;
        els.btnSync.disabled = !allOk;
        els.btnAnalyze.disabled = !allOk;

        if (!allOk && state.running) {
          pauseAcquisition();
        }

        setBadge(els.badgeConn, allOk ? 'ok' : 'warn', allOk ? 'ENLACE LISTO' : 'CONFIG INCOMPLETA');
        return allOk;
      }

      els.apiKeyInput.addEventListener('input', validateConfig);
      els.scriptUrlInput.addEventListener('input', validateConfig);

      /* =========================================================
         CONTROL DE INTERVALO Y GENERACIÓN INDEPENDIENTE
         ========================================================= */
      els.intervalSlider.addEventListener('input', () => {
        state.intervalSec = Number(els.intervalSlider.value);
        els.intervalLabel.textContent = state.intervalSec;
        if (!state.running) {
          state.countdown = state.intervalSec;
          els.kpiCountdown.textContent = `${state.countdown} s`;
        }
      });

      function generateUniqueId() {
        const ts = Date.now().toString(36).toUpperCase();
        const rnd = Math.random().toString(36).substring(2, 6).toUpperCase();
        return `T1-${ts}-${rnd}`;
      }

      function generateTemperature() {
        // Aleatorio entre 20.0 y 40.0 °C con exactamente 1 decimal
        const raw = 20 + Math.random() * 20;
        return Math.round(raw * 10) / 10;
      }

      function classifyObservation(temp) {
        if (temp >= 36.0) return 'Alerta térmica alta (>=36 °C)';
        if (temp <= 22.0) return 'Banda térmica baja (<=22 °C)';
        return 'Operación térmica nominal';
      }

      function emitSample() {
        const temp = generateTemperature();
        const sample = {
          id: generateUniqueId(),
          timestamp: new Date().toISOString(),
          zona: 'Zona-T1',
          variable: 'Temperatura',
          valor: temp,
          unidad: '°C',
          observacion: classifyObservation(temp),
          origen: 'HMI-Auto-Logger',
          status: 'pending',
          errorMsg: ''
        };

        // Mostrar inmediatamente en HMI y encolar sin esperar respuesta de Sheets
        state.samples.push(sample);
        state.writeQueue.push(sample);

        els.kpiCurrent.textContent = `${temp.toFixed(1)} °C`;
        els.kpiLastId.textContent = `ID: ${sample.id}`;

        updateDashboardUI();
        processQueueSequentially();
      }

      function startAcquisition() {
        if (!validateConfig() || state.running) return;
        state.running = true;
        state.countdown = state.intervalSec;

        setBadge(els.badgeOp, 'ok', 'EN EJECUCIÓN');
        validateConfig();

        // Primera muestra inmediata al iniciar, luego cada t segundos exactos
        emitSample();

        state.tickTimerId = setInterval(() => {
          state.countdown -= 1;
          if (state.countdown <= 0) {
            state.countdown = state.intervalSec;
            emitSample();
          }
          els.kpiCountdown.textContent = `${state.countdown} s`;
        }, 1000);
      }

      function pauseAcquisition() {
        state.running = false;
        clearInterval(state.tickTimerId);
        state.tickTimerId = null;
        setBadge(els.badgeOp, 'warn', 'PAUSADO');
        els.kpiCountdown.textContent = '-- s';
        validateConfig();
      }

      els.btnStart.addEventListener('click', startAcquisition);
      els.btnPause.addEventListener('click', pauseAcquisition);

      /* =========================================================
         COLA SECUENCIAL FIFO (SIN SOLICITUDES SIMULTÁNEAS)
         ========================================================= */
      async function processQueueSequentially() {
        if (state.workerBusy || state.writeQueue.length === 0) return;
        if (!isValidAppsScriptUrl(els.scriptUrlInput.value)) return;

        state.workerBusy = true;
        els.workerBadge.textContent = 'WORKER: ENVIANDO...';
        els.workerBadge.style.color = 'var(--accent)';

        const url = els.scriptUrlInput.value.trim();

        while (state.writeQueue.length > 0) {
          const item = state.writeQueue[0]; // peek sin sacar hasta terminar intento
          try {
            const resp = await fetch(url, {
              method: 'POST',
              headers: { 'Content-Type': 'text/plain;charset=utf-8' },
              body: JSON.stringify({
                action: 'insert',
                record: {
                  id: item.id,
                  timestamp: item.timestamp,
                  zona: item.zona,
                  variable: item.variable,
                  valor: item.valor,
                  unidad: item.unidad,
                  observacion: item.observacion,
                  origen: item.origen
                }
              })
            });

            if (!resp.ok) {
              throw new Error(`HTTP ${resp.status}`);
            }

            const data = await resp.json();
            if (data.status === 'ok' && data.confirmed === true) {
              item.status = 'confirmed';
              setBadge(els.badgeConn, 'ok', 'SHEETS CONECTADO');
            } else {
              throw new Error(data.message || 'Respuesta sin confirmación de escritura.');
            }
          } catch (err) {
            // Nunca presentar registros fallidos como guardados
            item.status = 'error';
            item.errorMsg = err.message || 'Fallo de red';
            setBadge(els.badgeConn, 'err', 'ERROR DE ESCRITURA');
          } finally {
            state.writeQueue.shift();
            updateDashboardUI();
          }
        }

        state.workerBusy = false;
        els.workerBadge.textContent = 'WORKER: EN ESPERA';
        els.workerBadge.style.color = 'var(--text-muted)';
      }

      /* =========================================================
         CONSULTA DE HISTORIAL REAL EN GOOGLE SHEETS
         ========================================================= */
      async function fetchSheetsHistory() {
        if (!validateConfig()) return;
        const url = `${els.scriptUrlInput.value.trim()}?action=history`;
        els.btnSync.disabled = true;
        els.btnSync.textContent = '↻ Consultando...';

        try {
          const resp = await fetch(url, { method: 'GET' });
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const data = await resp.json();
          if (data.status !== 'ok') throw new Error(data.message || 'Error leyendo historial.');

          state.sheetsHistory = Array.isArray(data.records) ? data.records : [];
          renderSheetsTable();
          setBadge(els.badgeConn, 'ok', 'SHEETS SINCRONIZADO');
        } catch (err) {
          setBadge(els.badgeConn, 'err', 'ERROR CONSULTA');
          els.sheetsTableBody.innerHTML = `
            <tr><td colspan="8" style="color:var(--err);padding:1rem;">
              Error consultando Google Sheets: ${escapeHtml(err.message)}
            </td></tr>`;
        } finally {
          els.btnSync.disabled = false;
          els.btnSync.textContent = '↻ Consultar Sheets';
        }
      }

      els.btnSync.addEventListener('click', fetchSheetsHistory);

      function renderSheetsTable() {
        const rows = state.sheetsHistory;
        els.sheetsCountBadge.textContent = `${rows.length} FILAS`;

        if (rows.length === 0) {
          els.sheetsTableBody.innerHTML = `
            <tr><td colspan="8" style="color:var(--text-dim);text-align:center;padding:1rem;">
              La hoja «Registros» aún no tiene filas almacenadas.
            </td></tr>`;
          return;
        }

        const reversed = [...rows].reverse();
        els.sheetsTableBody.innerHTML = reversed.map(r => `
          <tr>
            <td>${escapeHtml(r.timestamp)}</td>
            <td style="color:var(--accent);">${escapeHtml(r.id)}</td>
            <td>${escapeHtml(r.zona)}</td>
            <td>${escapeHtml(r.variable)}</td>
            <td style="font-weight:700;">${Number(r.valor).toFixed(1)}</td>
            <td>${escapeHtml(r.unidad)}</td>
            <td>${escapeHtml(r.observacion)}</td>
            <td>${escapeHtml(r.origen)}</td>
          </tr>
        `).join('');
      }

      /* =========================================================
         ANÁLISIS CON OPENAI VÍA APPS SCRIPT
         ========================================================= */
      async function requestOpenAIAnalysis() {
        if (!validateConfig()) return;
        const url = els.scriptUrlInput.value.trim();
        const apiKey = els.apiKeyInput.value.trim();

        els.btnAnalyze.disabled = true;
        els.aiStatus.textContent = 'ANALIZANDO REGISTROS REALES...';
        els.aiStatus.style.color = 'var(--accent)';
        els.aiOutput.textContent = 'Solicitando a Google Apps Script la lectura de «Registros» y el análisis con OpenAI...';

        try {
          const resp = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              action: 'analyze',
              apiKey: apiKey
            })
          });

          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const data = await resp.json();

          if (data.status !== 'ok') {
            throw new Error(data.message || 'No se pudo completar el análisis.');
          }

          els.aiStatus.textContent = `COMPLETADO (${data.analyzedCount} FILAS)`;
          els.aiStatus.style.color = 'var(--ok)';
          els.aiOutput.textContent = data.analysis;

          // Refrescar tabla local para garantizar sincronía visual
          await fetchSheetsHistory();
        } catch (err) {
          els.aiStatus.textContent = 'ERROR EN ANÁLISIS';
          els.aiStatus.style.color = 'var(--err)';
          els.aiOutput.textContent = `Error al solicitar análisis a Apps Script / OpenAI:\n${err.message}`;
        } finally {
          validateConfig();
        }
      }

      els.btnAnalyze.addEventListener('click', requestOpenAIAnalysis);

      /* =========================================================
         ACTUALIZACIÓN DE DASHBOARD, COLA Y GRÁFICA CANVAS
         ========================================================= */
      function updateDashboardUI() {
        const total = state.samples.length;
        const confirmed = state.samples.filter(s => s.status === 'confirmed').length;
        const pending = state.samples.filter(s => s.status === 'pending').length;
        const errors = state.samples.filter(s => s.status === 'error').length;

        els.kpiGen.textContent = total;
        els.kpiConf.textContent = confirmed;
        els.kpiPend.textContent = pending;
        els.kpiErr.textContent = errors;

        if (total > 0) {
          const sum = state.samples.reduce((acc, s) => acc + s.valor, 0);
          els.kpiAvg.textContent = `${(sum / total).toFixed(1)} °C`;
        }

        if (errors > 0) {
          setBadge(els.badgeErr, 'err', `${errors} ERROR${errors > 1 ? 'ES' : ''}`);
        } else {
          setBadge(els.badgeErr, 'ok', '0 ERRORES');
        }

        renderQueueList();
        drawChart();
      }

      function renderQueueList() {
        if (state.samples.length === 0) return;
        const recent = [...state.samples].reverse().slice(0, 25);

        els.queueList.innerHTML = recent.map(s => {
          let tag = '';
          if (s.status === 'confirmed') {
            tag = `<span class="badge ok"><span class="dot"></span>CONFIRMADO</span>`;
          } else if (s.status === 'pending') {
            tag = `<span class="badge warn"><span class="dot"></span>PENDIENTE EN COLA</span>`;
          } else {
            tag = `<span class="badge err" title="${escapeHtml(s.errorMsg)}"><span class="dot"></span>FALLIDO (${escapeHtml(s.errorMsg)})</span>`;
          }

          return `
            <div class="queue-item">
              <div>
                <strong>${s.valor.toFixed(1)} °C</strong> · <span style="color:var(--text-muted);">${s.id}</span>
                <div style="font-size:0.7rem;color:var(--text-dim);">${s.timestamp}</div>
              </div>
              ${tag}
            </div>
          `;
        }).join('');
      }

      function drawChart() {
        const canvas = els.trendCanvas;
        const dpr = window.devicePixelRatio || 1;
        const rect = canvas.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;

        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        const ctx = canvas.getContext('2d');
        ctx.scale(dpr, dpr);

        const w = rect.width;
        const h = rect.height;
        const padL = 44, padR = 16, padT = 18, padB = 26;
        const plotW = w - padL - padR;
        const plotH = h - padT - padB;

        ctx.clearRect(0, 0, w, h);

        // Rejilla Y (20 °C a 40 °C)
        ctx.font = '11px monospace';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';

        [20, 25, 30, 35, 40].forEach(val => {
          const y = padT + plotH - ((val - 20) / 20) * plotH;
          ctx.strokeStyle = '#1e293b';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(padL, y);
          ctx.lineTo(w - padR, y);
          ctx.stroke();

          ctx.fillStyle = '#64748b';
          ctx.fillText(`${val}°`, padL - 6, y);
        });

        const pts = state.samples.slice(-30);
        if (pts.length === 0) {
          ctx.fillStyle = '#64748b';
          ctx.textAlign = 'center';
          ctx.fillText('Esperando muestras automáticas (20.0 – 40.0 °C)...', w / 2, h / 2);
          return;
        }

        const stepX = pts.length > 1 ? plotW / (pts.length - 1) : 0;

        // Línea de tendencia
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 2;
        ctx.beginPath();
        pts.forEach((p, i) => {
          const x = padL + (pts.length === 1 ? plotW / 2 : i * stepX);
          const y = padT + plotH - ((p.valor - 20) / 20) * plotH;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });
        ctx.stroke();

        // Puntos diferenciados por estado
        pts.forEach((p, i) => {
          const x = padL + (pts.length === 1 ? plotW / 2 : i * stepX);
          const y = padT + plotH - ((p.valor - 20) / 20) * plotH;

          ctx.fillStyle = p.status === 'confirmed'
            ? '#10b981'
            : (p.status === 'pending' ? '#f59e0b' : '#ef4444');

          ctx.beginPath();
          ctx.arc(x, y, 4.5, 0, Math.PI * 2);
          ctx.fill();
        });
      }

      window.addEventListener('resize', drawChart);

      /* =========================================================
         UTILIDADES
         ========================================================= */
      function setBadge(el, type, text) {
        el.className = `badge ${type}`;
        el.innerHTML = `<span class="dot"></span>${escapeHtml(text)}`;
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      els.btnCopyCode.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(els.codeGsBlock.textContent);
          els.btnCopyCode.textContent = '✓ Copiado';
          setTimeout(() => { els.btnCopyCode.textContent = '📋 Copiar Code.gs'; }, 2000);
        } catch {
          els.btnCopyCode.textContent = 'Error al copiar';
        }
      });

      // Inicialización visual
      validateConfig();
      drawChart();
    })();
  </script>
</body>
</html>
